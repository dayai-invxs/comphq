{
  "name": "comphq-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter @comphq/web dev",
    "dev:functions": "deno run --env-file=.env.local --allow-net --allow-env --allow-read --allow-sys --config supabase/functions/deno.json supabase/functions/_dev/serve.ts",
    "build": "pnpm --filter @comphq/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "parity:token": "node tools/parity-user.mjs",
    "test:sql": "node tools/db-test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @comphq/web typecheck",
    "lint": "eslint .",
    "check:tokens": "node tools/check-tokens.mjs",
    "verify": "pnpm check:tokens && pnpm check:functions && pnpm check:deno && pnpm typecheck && pnpm lint && pnpm test",
    "db:inventory": "node tools/db-push.mjs --inventory",
    "db:wipe": "node tools/db-push.mjs --wipe",
    "db:push": "node tools/db-push.mjs --push",
    "db:verify": "node tools/db-verify.mjs",
    "db:golden": "node tools/golden-db.mjs",
    "db:seed": "node tools/db-seed.mjs",
    "gen:deno": "node tools/deno-config.mjs",
    "check:deno": "node tools/deno-config.mjs --check && deno check --config supabase/functions/deno.json supabase/functions/*/index.ts supabase/functions/_dev/serve.ts",
    "gen:functions": "node tools/gen-functions.mjs",
    "check:functions": "node tools/gen-functions.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.0",
    "@supabase/supabase-js": "^2.112.4",
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.2",
    "globals": "^17.11.0",
    "postgres": "^3.4.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.0",
    "zod": "^4.4.3"
  }
}
