# Hosted Supabase project (comphq-test).
# SUPABASE_DB_URL must be the SESSION pooler (port 5432), not the
# transaction pooler (6543) — migrations run multi-statement DDL in
# transactions and the transaction pooler cannot hold them.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
# The Edge Functions build a user-scoped client with it, so local
# `pnpm dev:functions` needs it as well as the browser does.
SUPABASE_ANON_KEY=<anon-key>

# Optional, for the Edge Functions. The transaction pooler (port 6543), used
# in place of SUPABASE_DB_URL when set. Deployed functions cannot override
# SUPABASE_DB_URL (the platform reserves the prefix), so this is how they
# reach the pooler: `supabase secrets set DB_POOLER_URL=...`.
# DB_POOLER_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional. Where the Edge Functions answer, when that is not the project
# itself. Point it at a local `supabase functions serve` (or
# `deno run supabase/functions/_dev/serve.ts`) while developing; auth and
# Realtime keep using VITE_SUPABASE_URL either way.
# VITE_FUNCTIONS_URL=http://localhost:54321

# Optional. Pins where the Edge Functions run (sent as the x-region header).
# Set it to the database's region: without it each call runs nearest the
# caller and pays the distance to the database on every query.
# VITE_FUNCTIONS_REGION=<region, e.g. us-east-1>
